# GM site: builds from content/ + gm/ merged (see scripts/prepare-gm-content.mjs),
# so shared pages stay at the same slugs as the player site and each
# top-level gm/ folder (Party Info, Session Info, Gamemaster Info) becomes
# its own top-level section, sitting alongside content/'s World Info. Pages
# can [[wikilink]] to either tree.
FROM node:22-slim AS builder
WORKDIR /usr/src/app

RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json* quartz.lock.json ./
COPY quartz/ ./quartz/
RUN npm ci && npx quartz plugin install

COPY quartz.ts quartz.config.yaml quartz.config.default.yaml tsconfig.json globals.d.ts index.d.ts ./
COPY scripts/ ./scripts/
COPY content/ ./content/
COPY gm/ ./gm/
ENV QUARTZ_BASE_URL=gm.eldressa.fyi
RUN node scripts/prepare-gm-content.mjs .gm-build/content && \
    npx quartz build -d .gm-build/content -o public

FROM nginx:alpine
COPY --from=builder /usr/src/app/public /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
